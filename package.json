{
  "name": "session-keystore",
  "version": "0.0.0-semantically-released",
  "description": "Secure cryptographic key storage in the browser",
  "keywords": [
    "key-storage",
    "session-storage"
  ],
  "license": "MIT",
  "author": {
    "name": "François Best",
    "email": "contact@francoisbest.com",
    "url": "https://francoisbest.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/47ng/session-keystore"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "demo": "vite demo",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "knip": "knip",
    "lint": "oxlint --deny-warnings",
    "lint:commit": "commitlint --edit",
    "prepare": "git config --local --replace-all include.path ../git-hooks.gitconfig \"^\\\\.\\\\./git-hooks\\\\.gitconfig$\" || true",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:watch": "vitest",
    "typecheck": "tsc",
    "validate": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm knip && pnpm build && pnpm test"
  },
  "dependencies": {
    "@47ng/codec": "^1.0.0",
    "@stablelib/sha256": "1.0.1",
    "mitt": "^3.0.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.19.2",
    "@vitest/browser-playwright": "^5.1.0",
    "conventional-changelog-conventionalcommits": "^9.3.1",
    "knip": "^6.44.1",
    "oxfmt": "^0.76.0",
    "oxlint": "^1.91.0",
    "semantic-release": "^25.0.9",
    "typescript": "7.0.2",
    "vite": "^8.3.5",
    "vitest": "^5.1.0"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "body-leading-blank": [
        2,
        "always",
        true
      ],
      "subject-case": [
        0,
        "always",
        "sentence-case"
      ],
      "type-enum": [
        2,
        "always",
        [
          "build",
          "chore",
          "ci",
          "clean",
          "doc",
          "feat",
          "fix",
          "perf",
          "ref",
          "revert",
          "style",
          "test"
        ]
      ]
    }
  },
  "release": {
    "branches": [
      "master"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits"
        }
      ],
      [
        "@semantic-release/release-notes-generator",
        {
          "preset": "conventionalcommits"
        }
      ],
      "@semantic-release/npm",
      "@semantic-release/github"
    ]
  },
  "packageManager": "pnpm@12.10.1"
}
