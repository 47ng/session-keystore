{
  "name": "session-keystore",
  "version": "0.0.0-semantically-released",
  "description": "Secure cryptographic key storage in the browser",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "license": "MIT",
  "author": {
    "name": "François Best",
    "email": "contact@francoisbest.com",
    "url": "https://francoisbest.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/47ng/session-keystore"
  },
  "keywords": [
    "key-storage",
    "session-storage"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "rm -rf dist && tsc",
    "test:e2e": "playwright test",
    "validate": "pnpm build && pnpm test"
  },
  "dependencies": {
    "@47ng/codec": "^1.0.0",
    "@stablelib/sha256": "1.0.1",
    "mitt": "^2.1.0"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^11.0.0",
    "@playwright/test": "1.64.1",
    "@types/node": "^14.14.5",
    "@vitest/browser-playwright": "^5.1.0",
    "commitlint": "^11.0.0",
    "conventional-changelog-conventionalcommits": "^10.4.1",
    "esbuild": "0.28.2",
    "semantic-release": "^25.0.9",
    "ts-node": "^9.0.0",
    "typescript": "^4.0.5",
    "vitest": "^5.1.0"
  },
  "browser": {
    "crypto": false
  },
  "prettier": {
    "arrowParens": "avoid",
    "semi": false,
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "none",
    "useTabs": false
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ],
    "rules": {
      "type-enum": [
        2,
        "always",
        [
          "build",
          "chore",
          "ci",
          "clean",
          "doc",
          "feat",
          "fix",
          "perf",
          "ref",
          "revert",
          "style",
          "test"
        ]
      ],
      "subject-case": [
        0,
        "always",
        "sentence-case"
      ],
      "body-leading-blank": [
        2,
        "always",
        true
      ]
    }
  },
  "packageManager": "pnpm@12.10.1",
  "release": {
    "branches": [
      "master"
    ],
    "plugins": [
      [
        "@semantic-release/commit-analyzer",
        {
          "preset": "conventionalcommits"
        }
      ],
      [
        "@semantic-release/release-notes-generator",
        {
          "preset": "conventionalcommits"
        }
      ],
      "@semantic-release/npm",
      "@semantic-release/github"
    ]
  }
}
